# Copia este archivo a app/.env (ese no se sube a git).
# En el emulador, 10.0.2.2 es tu computadora. En un celular real, usa la IP de tu computadora.
API_URL=http://10.0.2.2:4000/api/v1

# De la app Android en Firebase (paquete pe.seima.app). Vacío: se puede entrar, sin avisos.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
