---
import Base from '../layouts/Base.astro';
import Words from '../components/Words.astro';
import Quote from '../components/quote/Quote';
---
<Base
  title="Arma tu cotización · SEIMA Servicios Generales"
  description="Cuéntanos qué necesitas en pocos pasos y te respondemos por WhatsApp. Drywall, enchapado, electricidad, melamina y pintura en Lima y provincias."
>
  <section class="qpage light">
    <div class="wrap">
      <header class="qhead">
        <p class="eyebrow">Cotizador</p>
        <h1><Words text="Arma tu" accent="cotización." /></h1>
        <p class="qhead__lead">Responde unas preguntas y nos llega todo ordenado para revisarlo. Al final se abre WhatsApp con tu solicitud lista.</p>
      </header>
      <Quote client:load />
    </div>
  </section>
</Base>

<style>
  .qpage { padding-block: clamp(2.2rem, 6vw, 4.5rem) clamp(6rem, 9vw, 7rem); min-height: 80svh; }
  .qhead { display: grid; gap: 0.9rem; margin-bottom: clamp(1.4rem, 4vw, 2.2rem); }
  .qhead h1 { font-size: clamp(2.6rem, 9vw, 5rem); line-height: 0.98; letter-spacing: -0.02em; }
  .qhead__lead { color: var(--muted-light); max-width: 42rem; font-size: clamp(1rem, 2.4vw, 1.15rem); }
</style>
