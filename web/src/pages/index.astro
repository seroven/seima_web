---
import Base from '../layouts/Base.astro';
import House from '../components/House.astro';
import Wall from '../components/Wall.astro';
import Words from '../components/Words.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

// Cada servicio es una capa de la pared (mismo orden que el brief).
const services = [
  { n: '01', t: 'Drywall', d: 'Perfiles, placas, divisiones, techos y puertas corredizas. Hasta departamentos completos.', href: '/proyectos?categoria=departamentos' },
  { n: '02', t: 'Enchapado', d: 'Porcelanato en cocinas, baños, cocheras y fachadas, con cortes a 45° y bordes biselados.', href: '/proyectos?categoria=cocinas' },
  { n: '03', t: 'Electricidad', d: 'Cableado dentro de las divisiones, tomas e iluminación LED integrada.', href: '/proyectos' },
  { n: '04', t: 'Melamina', d: 'Muebles a medida: cocina, closets y reposteros.', href: '/proyectos?categoria=melamina' },
  { n: '05', t: 'Pintura y remodelación', d: 'Empastado, pintura y solución de salitre; remodelaciones completas.', href: '/proyectos?categoria=remodelaciones' },
];
const marquee = ['Drywall', 'Enchapado', 'Electricidad', 'Melamina', 'Pintura', 'Remodelaciones'];

// Solo cifras reales: TikTok (docs/fuentes/tiktok-analisis.md) y el dato de Sebas (+50 proyectos, aproximado). Lo demás, placeholder.
const stats = [
  { v: 50, dec: 0, prefix: '+', label: 'proyectos entregados', hot: true },
  { v: 464, dec: 0, suffix: 'K', label: 'vistas en su video más visto' },
  { v: 7.3, dec: 1, suffix: 'K', label: 'seguidores en TikTok' },
  { v: null, label: 'y provincias', ph: 'Lima' },
];
---
<Base
  title="SEIMA Servicios Generales · Drywall, enchapado y acabados en Lima"
  description="Construimos tu espacio, capa por capa. Drywall, enchapado, electricidad, melamina y pintura en Lima y provincias."
>
  <!-- ESCENAS: portada → zoom a la cocina → la pared se arma por oficios (todo en un mismo escenario) -->
  <div class="scenes dark" data-scenes>
    <div class="scenes__bg" aria-hidden="true"></div>

    <section class="scene scene--hero">
      <div class="wrap hero__grid">
        <div class="hero__copy" data-hero-copy>
          <p class="eyebrow" data-hero-in>Drywall · Enchape · Electricidad · Melamina · Pintura</p>
          <h1><Words text="Construimos tu espacio," accent="capa por capa." br /></h1>
          <p class="hero__lead" data-hero-in>Desde una cocina hasta un departamento completo. Toca un ambiente de la casa y mira lo que hemos hecho ahí.</p>
          <div class="hero__cta" data-hero-in>
            <a class="btn btn--lg" href="/proyectos">Ver proyectos →</a>
            <a class="btn btn--ghost btn--lg" href="/cotizador">Arma tu cotización</a>
          </div>
        </div>
        <div class="hero__art">
          <House />
        </div>
      </div>
    </section>

    <section class="scene scene--layers" aria-labelledby="layers-title">
      <div class="wrap layers__grid">
        <div class="layers__copy">
          <p class="eyebrow">Lo que hacemos</p>
          <h2 id="layers-title" class="layers__title"><Words text="Un solo equipo." accent="Todo el acabado." br /></h2>
          <div class="svc-list" data-svc-list>
            {services.map((s) => (
              <article class="svc" data-svc>
                <span class="svc__n">{s.n}</span>
                <h3>{s.t}</h3>
                <p>{s.d}</p>
                <a class="svc__link" href={s.href}>Ver proyectos <span aria-hidden="true">→</span></a>
              </article>
            ))}
          </div>
          <ol class="rail" data-rail aria-hidden="true">
            {services.map(() => <li><i></i></li>)}
          </ol>
        </div>
        <div class="layers__art"><Wall /></div>
      </div>
    </section>
  </div>

  <!-- MARQUESINA -->
  <div class="marquee dark" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <ul>{marquee.map((m) => <li>{m}<span>✦</span></li>)}</ul>
      ))}
    </div>
  </div>

  <!-- TRABAJOS: galería horizontal -->
  <section class="gallery dark" data-gallery>
    <div class="wrap gallery__head">
      <div>
        <p class="eyebrow">Trabajos destacados</p>
        <h2 class="sec-title"><Words text="Mira cómo queda" /></h2>
      </div>
      <a class="gallery__all" href="/proyectos">Ver todo el catálogo →</a>
    </div>
    <div class="gallery__view" data-gallery-view>
      <div class="gallery__track" data-gallery-track>
        {projects.map((p) => (
          <div class="gcard"><ProjectCard project={p} ar="4 / 5" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CIFRAS: quedan fijas y la zona clara se monta encima -->
  <section class="stats dark">
    <div class="wrap">
      <p class="eyebrow" data-reveal>En números</p>
      <div class="stats__grid">
        {stats.map((s) => (
          <div class={`stat ${s.hot ? 'stat--hot' : ''}`} data-reveal>
            <p class:list={['stat__n', s.v === null && s.ph?.startsWith('[') && 'stat__n--ph']}>
              {s.v !== null
                ? <>{s.prefix}<span data-count={s.v} data-dec={s.dec}>{s.v.toFixed(s.dec)}</span>{s.suffix}</>
                : <>{s.ph}</>}
            </p>
            <p class="stat__l">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOGAR / EMPRESAS + CIERRE -->
  <div class="light tail">
    <section class="wrap duo-cards">
      <a class="dcard dcard--light" href="/proyectos" data-reveal="curtain">
        <span class="eyebrow">Para tu hogar</span>
        <span class="dcard__t">Cocinas, baños y remodelaciones</span>
        <span class="dcard__d">Mira trabajos reales y cuéntanos qué necesitas.</span>
        <span class="dcard__go">Ver proyectos →</span>
      </a>
      <a class="dcard dcard--dark" href="/empresas" data-reveal="curtain">
        <span class="eyebrow">Para empresas</span>
        <span class="dcard__t">Departamentos, locales y obras</span>
        <span class="dcard__d">Un solo equipo para estructura, enchape, electricidad y pintura.</span>
        <span class="dcard__go">Ver cómo trabajamos →</span>
      </a>
    </section>
    <section class="wrap closing-wrap">
      <div class="closing" data-reveal="curtain" data-noexit>
        <h2><Words text="¿Tienes un espacio" accent="en mente?" br /></h2>
        <a class="btn btn--ink btn--lg" href="/cotizador">Empezar mi cotización →</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .sec-title { font-size: clamp(2.1rem, 6vw, 3.6rem); margin-top: 0.6rem; }

  /* ---------- Escenas ---------- */
  .scenes { position: relative; overflow: hidden; }
  .scenes__bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(55% 55% at 78% 55%, rgb(224 40 60 / 0.15), transparent 70%),
      radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.5px) 0 0 / 28px 28px;
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .scene { position: relative; }
  /* Modo escenario (JS, escritorio): todo ocupa la misma pantalla fija */
  .scenes.is-master { height: calc(100svh - var(--header)); }
  .is-master .scene { position: absolute; inset: 0; display: grid; align-items: center; }

  /* Hero */
  .hero__grid { display: grid; gap: 2.5rem; align-items: center; padding-block: clamp(2.2rem, 6vw, 5rem) clamp(2.5rem, 6vw, 4rem); }
  .hero__copy { display: grid; gap: clamp(1rem, 2.4vw, 1.6rem); align-content: center; }
  .scene--hero .eyebrow { font-size: 0.7rem; letter-spacing: 0.12em; color: #ff6b7a; }
  .scene--hero h1 { font-size: clamp(2.6rem, 9.5vw, 4.9rem); line-height: 0.98; letter-spacing: -0.02em; }
  .hero__lead { color: #b5b5b5; font-size: clamp(1.02rem, 2.4vw, 1.2rem); max-width: 34rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hero__art { display: grid; gap: 1rem; }
  @media (min-width: 900px) {
    .hero__grid { grid-template-columns: 1fr 1.3fr; gap: 3rem; }
    .scene--hero .eyebrow { font-size: 0.78rem; letter-spacing: 0.14em; }
  }

  /* Capas (servicios) */
  .scene--layers { padding-block: clamp(3rem, 8vw, 6rem); }
  .layers__grid { display: grid; gap: 2rem; align-items: center; }
  .layers__title { font-size: clamp(1.6rem, 3.6vw, 2.5rem); margin: 0.5rem 0 1.4rem; }
  .svc-list { display: grid; gap: 1.6rem; }
  .svc { display: grid; gap: 0.5rem; justify-items: start; }
  .svc__n { color: var(--red); font-weight: 800; font-size: 0.95rem; }
  .svc h3 { font-size: clamp(2.1rem, 4.4vw, 3.6rem); line-height: 1; max-width: 11ch; }
  .svc p { color: #a9a9a9; max-width: 30rem; font-size: clamp(1rem, 2.2vw, 1.12rem); }
  .svc__link { font-weight: 700; text-decoration: none; border-bottom: 2px solid var(--red); padding-bottom: 2px; }
  .rail { display: none; list-style: none; margin: 1.6rem 0 0; padding: 0; gap: 0.4rem; }
  .rail li { flex: 1; height: 4px; background: #2e2e2e; border-radius: 4px; overflow: hidden; max-width: 4.5rem; }
  .rail i { display: block; height: 100%; background: var(--red); transform-origin: 0 50%; transform: scaleX(0); }
  @media (min-width: 900px) { .layers__grid { grid-template-columns: 1fr 1.15fr; gap: 3rem; } }

  /* Con JS: los textos se apilan y cambian con el scroll */
  .scene--layers.is-scrub { padding-block: 1rem; }
  .is-scrub .svc-list { position: relative; min-height: 17rem; }
  .is-scrub .svc { position: absolute; inset: 0 auto auto 0; width: 100%; }
  .is-scrub .rail { display: flex; }
  .scene--layers.is-solo { height: calc(100svh - var(--header)); display: grid; align-items: center; overflow: hidden; }

  /* ---------- Marquesina ---------- */
  .marquee { overflow: hidden; border-block: 1px solid #262626; padding-block: 1.2rem; position: relative; z-index: 1; }
  .marquee__track { display: flex; width: max-content; animation: marquee 34s linear infinite; }
  .marquee:hover .marquee__track { animation-play-state: paused; }
  .marquee ul { display: flex; gap: 3.5rem; list-style: none; margin: 0; padding: 0 3.5rem 0 0; }
  .marquee li {
    display: flex; gap: 3.5rem; align-items: center; white-space: nowrap;
    font-stretch: 118%; font-weight: 900; text-transform: uppercase; font-size: clamp(1.4rem, 4vw, 2.1rem);
  }
  .marquee li span { color: var(--red); }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ---------- Galería horizontal ---------- */
  .gallery { padding-block: clamp(3rem, 8vw, 6rem); overflow: hidden; }
  .gallery__head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1rem; margin-bottom: clamp(1.2rem, 3vw, 2rem); }
  .gallery__all { font-weight: 700; border-bottom: 2px solid var(--red); padding-bottom: 3px; text-decoration: none; }
  .gallery__view { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-block: 10px; margin-block: -10px; } /* sitio para el anillo de foco */
  .gallery__view::-webkit-scrollbar { display: none; }
  .gallery__track {
    display: flex; gap: 1.2rem; width: max-content;
    padding-inline: max(var(--pad), calc((100vw - var(--max)) / 2 + var(--pad)));
  }
  .gcard { flex: 0 0 min(78vw, 22rem); scroll-snap-align: start; }
  .gallery.is-pinned { height: calc(100svh - var(--header)); display: flex; flex-direction: column; justify-content: center; padding-block: 1rem; }
  .gallery.is-pinned .gallery__view { overflow: hidden; scroll-snap-type: none; }
  .gallery.is-pinned .gcard { flex-basis: min(24rem, 40svh); }
  .gallery.is-pinned .sec-title { font-size: clamp(1.8rem, 4vw, 2.8rem); }

  /* ---------- Cifras (fijas mientras la zona clara sube) ---------- */
  .stats { position: sticky; top: var(--header); z-index: 0; min-height: calc(100svh - var(--header)); display: grid; align-content: center; padding-block: 3rem 8rem; }
  .stats__grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); margin-top: 1.5rem; }
  .stat { border-top: 2px solid #333; padding-top: 1.1rem; }
  .stat--hot { border-color: var(--red); }
  .stat__n { font-stretch: 118%; font-weight: 900; font-size: clamp(2.6rem, 7vw, 4.4rem); line-height: 1; }
  .stat__n--ph { font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.35; color: var(--red); padding-block: 0.55rem; }
  .stat__l { margin-top: 0.4rem; color: var(--muted-dark); }

  /* ---------- Hogar / empresas / cierre ---------- */
  .tail { position: relative; z-index: 1; border-radius: 36px 36px 0 0; margin-top: -4rem; padding-block: clamp(3rem, 8vw, 6rem); box-shadow: 0 -30px 60px rgb(0 0 0 / 0.4); }
  .duo-cards { display: grid; gap: 1.2rem; }
  @media (min-width: 800px) { .duo-cards { grid-template-columns: 1fr 1fr; } }
  .dcard {
    display: flex; flex-direction: column; gap: 0.9rem; text-decoration: none;
    border-radius: 28px; padding: clamp(1.6rem, 4vw, 2.75rem); min-height: 18rem;
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0, 1);
  }
  .dcard:hover { translate: 0 -6px; }
  .dcard--light { background: var(--paper-2); }
  .dcard--dark { background: var(--ink-2); color: #fff; }
  .dcard--dark .eyebrow { color: #ff6b7a; }
  .dcard__t { font-stretch: 118%; font-weight: 900; font-size: clamp(1.7rem, 4.5vw, 2.5rem); line-height: 1.05; }
  .dcard__d { color: var(--muted-light); }
  .dcard--dark .dcard__d { color: #a9a9a9; }
  .dcard__go { margin-top: auto; font-weight: 800; color: var(--red-text); }
  .dcard--dark .dcard__go { color: #ff6b7a; }
  .closing-wrap { margin-top: 1.2rem; }
  .closing {
    background: var(--red); color: #fff; border-radius: 32px;
    padding: clamp(1.8rem, 6vw, 4rem); display: flex; flex-wrap: wrap; gap: 1.5rem;
    justify-content: space-between; align-items: center;
  }
  .closing h2 { font-size: clamp(2rem, 6vw, 3.3rem); }
  .closing :global(.accent) { color: #0e0e0e; }
</style>
