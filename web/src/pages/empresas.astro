---
import Base from '../layouts/Base.astro';
import Words from '../components/Words.astro';
import Plan from '../components/Plan.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { cargarSitio } from '../lib/proyectos-publicos';
import { categoriasDe } from '../data/projects';

// Capacidad: solo trabajos que Luis realmente hace (docs/fuentes/tiktok-analisis.md)
const capacidades = [
  { n: '01', t: 'Varios departamentos a la vez', d: 'Estructura, divisiones y acabados de proyectos de varios departamentos, con un solo equipo y un solo responsable.' },
  { n: '02', t: 'Obras de dos pisos', d: 'De la estructura al acabado, entregadas completas.' },
  { n: '03', t: 'Locales comerciales', d: 'Tiendas y consultorios: divisiones, techos, enchape, electricidad y pintura.' },
  { n: '04', t: 'Mano de obra o llave en mano', d: 'Si ya tienes los materiales, trabajamos solo la mano de obra.' },
];

const pasos = [
  { n: '01', t: 'Visita técnica', d: 'Metrado y revisión de planos en obra.' },
  { n: '02', t: 'Propuesta por partidas', d: 'Alcance, plazos y etapas claras.' },
  { n: '03', t: 'Avance documentado', d: 'Fotos y reportes por WhatsApp mientras se trabaja.' },
  { n: '04', t: 'Entrega y revisión', d: 'Recorrido final contigo para revisar cada detalle.' },
];

// Proyectos de escala: departamentos y trabajos para empresas
const sitio = await cargarSitio();
const escala = sitio.projects.filter((p) => p.cliente === 'empresa' || categoriasDe(p).includes('departamentos')).slice(0, 3);
const propuesta = '/cotizador?cliente=empresa';
---
<Base
  title="Empresas · Departamentos, locales y obras · SEIMA Servicios Generales"
  description="Departamentos, locales y obras llave en mano: estructura, enchape, electricidad y pintura con un solo equipo. Visita técnica, propuesta por partidas y avance documentado en Lima y provincias."
>
  <!-- HERO -->
  <section class="ehero dark">
    <div class="ehero__bg" aria-hidden="true"></div>
    <div class="wrap ehero__grid">
      <div class="ehero__copy">
        <p class="eyebrow" data-hero-in>Empresas e inversionistas</p>
        <h1><Words text="Departamentos, locales y obras" accent="llave en mano." br /></h1>
        <p class="ehero__lead" data-hero-in>Un solo equipo para estructura, enchape, electricidad y pintura. Plazos claros y avance documentado.</p>
        <div class="ehero__cta" data-hero-in>
          <a class="btn btn--lg" href={propuesta}>Solicitar propuesta →</a>
          <a class="btn btn--ghost btn--lg" href="/proyectos?categoria=locales">Ver proyectos</a>
        </div>
      </div>
      <div class="ehero__art"><Plan /></div>
    </div>
  </section>

  <!-- CAPACIDAD (bento) -->
  <section class="cap dark">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Lo que hacemos a escala</p>
      <h2 class="sec-title"><Words text="Trabajos grandes," accent="mismo cuidado." br /></h2>
      <div class="bento">
        {capacidades.map((c, i) => (
          <article class={`ccard ccard--${i}`} data-reveal="curtain">
            <span class="ccard__n">{c.n}</span>
            <h3>{c.t}</h3>
            <p>{c.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PROYECTOS DE ESCALA -->
  <section class="esc dark">
    <div class="wrap">
      <div class="esc__head">
        <div>
          <p class="eyebrow" data-reveal>Proyectos de escala</p>
          <h2 class="sec-title"><Words text="Así se ven" accent="por dentro." br /></h2>
        </div>
        <a class="esc__all" href="/proyectos">Ver todo el catálogo →</a>
      </div>
      <div class="esc__grid">
        {escala.map((p) => (
          <div class="esc__item" data-reveal><ProjectCard project={p} ar="4 / 3" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- CIFRAS (solo reales) -->
  <section class="nums dark">
    <div class="wrap nums__grid">
      <div class="num num--hot" data-reveal>
        <p class="num__n">+<span data-count="50" data-dec="0">50</span></p>
        <p class="num__l">proyectos entregados</p>
      </div>
      <div class="num" data-reveal>
        <p class="num__n">+<span data-count="10" data-dec="0">10</span></p>
        <p class="num__l">años de experiencia en el rubro</p>
      </div>
      <div class="num" data-reveal>
        <p class="num__n">Lima</p>
        <p class="num__l">y provincias</p>
      </div>
    </div>
  </section>

  <!-- CÓMO TRABAJAMOS: la línea se llena con el scroll y cada paso se enciende -->
  <div class="light tail">
    <section class="proc" data-proc aria-labelledby="proc-title">
      <div class="wrap proc__grid">
        <div class="proc__intro">
          <p class="eyebrow">Cómo trabajamos</p>
          <h2 id="proc-title" class="sec-title"><Words text="Proceso claro," accent="de inicio a entrega." br /></h2>
          <p class="proc__lead" data-reveal>Cada obra sigue los mismos cuatro pasos, para que sepas qué viene y cuándo.</p>
        </div>
        <div class="proc__right" data-proc-list>
        <span class="proc__line" aria-hidden="true"><i data-proc-fill></i></span>
        <ol class="proc__list">
          {pasos.map((p) => (
            <li class="pstep" data-pstep>
              <span class="pstep__n">{p.n}</span>
              <div>
                <h3>{p.t}</h3>
                <p>{p.d}</p>
              </div>
            </li>
          ))}
        </ol>
        </div>
      </div>
    </section>

    <section class="wrap closing-wrap">
      <div class="closing" data-reveal="curtain" data-noexit>
        <h2><Words text="¿Tienes un proyecto" accent="en mente?" br /></h2>
        <div class="closing__cta">
          <a class="btn btn--ink btn--lg" href={propuesta}>Solicitar propuesta →</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .sec-title { font-size: clamp(2.1rem, 6vw, 3.6rem); margin-top: 0.6rem; }

  /* ---------- Hero ---------- */
  .ehero { position: relative; overflow: hidden; }
  .ehero__bg {
    position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(55% 55% at 78% 55%, rgb(224 40 60 / 0.15), transparent 70%),
      radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.5px) 0 0 / 28px 28px;
    mask-image: linear-gradient(#000 70%, transparent);
  }
  .ehero__grid { position: relative; display: grid; gap: 2.5rem; align-items: center; padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3rem, 7vw, 6rem); }
  .ehero__copy { display: grid; gap: clamp(1rem, 2.4vw, 1.6rem); align-content: center; }
  .ehero .eyebrow { color: #ff6b7a; }
  .ehero h1 { font-size: clamp(2.2rem, 7.4vw, 3.8rem); line-height: 0.98; letter-spacing: -0.02em; }
  .ehero__lead { color: #b5b5b5; font-size: clamp(1.02rem, 2.4vw, 1.2rem); max-width: 34rem; }
  .ehero__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  @media (min-width: 900px) { .ehero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 2.5rem; } }

  /* ---------- Capacidad: bento ---------- */
  .cap { padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2rem, 5vw, 3rem); }
  .bento { display: grid; gap: 1rem; margin-top: clamp(1.6rem, 4vw, 2.6rem); }
  .ccard { display: flex; flex-direction: column; gap: 0.7rem; padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: 24px; background: var(--ink-2); }
  .ccard__n { font-weight: 800; font-size: 0.9rem; color: var(--red); }
  .ccard h3 { font-size: clamp(1.4rem, 3.4vw, 2.1rem); line-height: 1.05; overflow-wrap: anywhere; hyphens: auto; }
  .ccard--2 h3, .ccard--3 h3 { font-size: clamp(1.3rem, 2.3vw, 1.75rem); }
  .ccard p { color: #a9a9a9; max-width: 34ch; }
  .ccard--0 { background: var(--red); }
  .ccard--0 .ccard__n { color: #0e0e0e; }
  .ccard--0 p { color: #fff; opacity: 0.92; }
  .ccard--2 { background: var(--paper-2); color: var(--ink); }
  .ccard--2 .ccard__n { color: var(--red-text); }
  .ccard--2 p { color: var(--muted-light); }
  @media (min-width: 800px) {
    .bento { grid-template-columns: repeat(12, 1fr); grid-auto-rows: minmax(13rem, auto); }
    .ccard--0 { grid-column: span 6; grid-row: span 2; justify-content: flex-end; }
    .ccard--0 h3 { font-size: clamp(2rem, 4vw, 3rem); }
    .ccard--1 { grid-column: span 6; }
    .ccard--2 { grid-column: span 3; }
    .ccard--3 { grid-column: span 3; }
  }

  /* ---------- Proyectos de escala ---------- */
  .esc { padding-block: clamp(2rem, 5vw, 3rem) clamp(3rem, 8vw, 6rem); }
  .esc__head { display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 1rem; margin-bottom: clamp(1.4rem, 3vw, 2.2rem); }
  .esc__all { font-weight: 700; border-bottom: 2px solid var(--red); padding-bottom: 3px; text-decoration: none; }
  .esc__grid { display: grid; gap: clamp(1.2rem, 3vw, 2rem); grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); }

  /* ---------- Cifras ---------- */
  .nums { padding-block: clamp(2.5rem, 7vw, 5rem) clamp(5rem, 10vw, 8rem); }
  .nums__grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); }
  .num { border-top: 2px solid #333; padding-top: 1.1rem; }
  .num--hot { border-color: var(--red); }
  .num__n { font-stretch: 118%; font-weight: 900; font-size: clamp(2.8rem, 8vw, 4.8rem); line-height: 1; }
  .num__l { margin-top: 0.4rem; color: var(--muted-dark); }

  /* ---------- Cómo trabajamos ---------- */
  .tail { position: relative; z-index: 1; border-radius: 36px 36px 0 0; margin-top: -4rem; padding-block: clamp(3.5rem, 8vw, 6rem); box-shadow: 0 -30px 60px rgb(0 0 0 / 0.4); }
  .proc__grid { display: grid; gap: 2.5rem; }
  .proc__lead { margin-top: 1rem; color: var(--muted-light); max-width: 32rem; }
  .proc__right { position: relative; }
  .proc__list { position: relative; list-style: none; margin: 0; padding: 0 0 0 3.2rem; display: grid; gap: clamp(2.5rem, 7vw, 4.5rem); }
  .proc__line { position: absolute; left: 1rem; top: 0.6rem; bottom: 0.6rem; width: 4px; border-radius: 4px; background: var(--tint-2); }
  .proc__line i { display: block; width: 100%; height: 100%; background: var(--red); border-radius: 4px; transform-origin: 50% 0; transform: scaleY(0); }
  .pstep { position: relative; display: grid; gap: 0.3rem; }
  .pstep::before { content: ''; position: absolute; left: -2.55rem; top: 0.45rem; width: 16px; height: 16px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 4px var(--tint-2); transition: background-color 0.3s ease, box-shadow 0.3s ease; }
  .pstep__n { font-size: clamp(2.6rem, 7vw, 4.4rem); font-weight: 900; font-stretch: 118%; line-height: 1; color: #cfcfcf; transition: color 0.4s ease; }
  .pstep h3 { font-size: clamp(1.4rem, 3.4vw, 2rem); }
  .pstep p { color: var(--muted-light); max-width: 32rem; }
  /* Con movimiento, los pasos sin llegar quedan atenuados y se encienden al pasar */
  :global(html.motion) .pstep > div { opacity: 0.35; transition: opacity 0.4s ease; }
  :global(html.motion) .pstep.is-on > div { opacity: 1; }
  .pstep.is-on::before { background: var(--red); box-shadow: 0 0 0 4px rgb(224 40 60 / 0.25); }
  .pstep.is-on .pstep__n { color: var(--red-text); }
  @media (min-width: 900px) {
    .proc__grid { grid-template-columns: 0.9fr 1.1fr; gap: 4rem; align-items: start; }
    .proc__intro { position: sticky; top: calc(var(--header) + 2rem); }
  }

  /* ---------- Cierre ---------- */
  .closing-wrap { margin-top: clamp(3rem, 7vw, 5rem); }
  .closing {
    background: var(--red); color: #fff; border-radius: 32px; padding: clamp(1.8rem, 6vw, 4rem);
    display: flex; flex-wrap: wrap; gap: 1.5rem; justify-content: space-between; align-items: center;
  }
  .closing h2 { font-size: clamp(2rem, 6vw, 3.3rem); }
  .closing :global(.accent) { color: #0e0e0e; }
</style>
