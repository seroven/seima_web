---
import Base from '../../layouts/Base.astro';
import Words from '../../components/Words.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, categories } from '../../data/projects';
---
<Base
  title="Proyectos · SEIMA Servicios Generales"
  description="Catálogo de proyectos de SEIMA: cocinas, baños, departamentos, melamina, techos y más, en Lima y provincias."
>
  <section class="head dark">
    <div class="wrap">
      <p class="eyebrow">Catálogo</p>
      <h1><Words text="Nuestros" accent="proyectos." /></h1>
      <p class="head__note">Proyectos de prueba: las fotos y datos reales se cargan después.</p>
    </div>
  </section>

  <section class="catalog light" data-catalog>
    <div class="wrap">
      <div class="chips" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="chip" data-filter="" aria-pressed="true">Todos</button>
        {categories.map((c) => <button type="button" class="chip" data-filter={c.slug} aria-pressed="false">{c.nombre}</button>)}
      </div>
      <p class="status" role="status" aria-live="polite" data-status></p>
      <div class="grid">
        {projects.map((p) => <div class="grid__item" data-cat={p.categoria}><ProjectCard project={p} /></div>)}
      </div>
      <p class="empty" data-empty hidden>Todavía no hay proyectos en esta categoría. Pronto subimos más.</p>
    </div>
  </section>
</Base>

<script>
  function setup() {
    const root = document.querySelector<HTMLElement>('[data-catalog]');
    if (!root) return;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...root.querySelectorAll<HTMLElement>('.grid__item')];
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const valid = new Set(chips.map((c) => c.dataset.filter));

    const apply = (cat: string, push = true) => {
      let shown = 0;
      items.forEach((el) => {
        const on = !cat || el.dataset.cat === cat;
        el.hidden = !on;
        if (on) shown++;
      });
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === cat)));
      empty.hidden = shown > 0;
      status.textContent = cat ? `${shown} proyecto${shown === 1 ? '' : 's'}` : '';
      if (push) {
        const url = new URL(location.href);
        if (cat) url.searchParams.set('categoria', cat);
        else url.searchParams.delete('categoria');
        history.replaceState(history.state, '', url);
      }
    };

    chips.forEach((c) => c.addEventListener('click', () => apply(c.dataset.filter ?? '')));
    const initial = new URLSearchParams(location.search).get('categoria') ?? '';
    apply(valid.has(initial) ? initial : '', false);
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .head { padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 5vw, 3.5rem); }
  .head h1 { font-size: clamp(2.4rem, 8vw, 5rem); margin-top: 0.6rem; }
  .head__note { margin-top: 1rem; color: var(--muted-dark); font-size: 0.9rem; }
  .catalog { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(4rem, 9vw, 7rem); min-height: 60svh; }
  .chips { display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.75rem; scrollbar-width: thin; }
  .chip {
    flex: none; font: inherit; font-weight: 600; font-size: 0.9rem; cursor: pointer;
    padding: 0.5rem 1rem; border-radius: 999px; border: 1.5px solid var(--ink); background: transparent; color: var(--ink);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .chip:hover { background: var(--paper-2); }
  .chip[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .status { min-height: 1.4em; font-size: 0.85rem; color: var(--muted-light); margin: 0.5rem 0 1rem; }
  .grid { display: grid; gap: clamp(1.4rem, 3vw, 2.2rem); grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .grid__item[hidden] { display: none; }
  .empty { padding: 3rem 0; color: var(--muted-light); }
</style>
