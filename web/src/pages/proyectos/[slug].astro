---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Words from '../../components/Words.astro';
import BackButton from '../../components/BackButton.astro';
import CompareSlider from '../../components/CompareSlider.astro';
import Presentation from '../../components/Presentation.astro';
import { categoriasNombre, categoryName, etapaLabel, etapas, fotosDe, fotosOrdenadas, principal, show, type Foto } from '../../data/projects';
import { cargarSitio, proyectoPublico } from '../../lib/proyectos-publicos';

export async function getStaticPaths() {
  const { projects } = await cargarSitio();
  return projects.map((project) => ({ params: { slug: project.slug } }));
}

const project = await proyectoPublico(Astro.params.slug ?? '');
if (!project) {
  return new Response('Esta obra no está publicada.', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}
const p = project;
// Todos los tipos de trabajo de la obra («Cocinas · Melamina»); el enlace del camino de migas va a la principal.
const cat = categoriasNombre(p);
const catPrincipal = categoryName(p.categoria);
const cover = principal(p, 'despues') ?? p.fotos[0];
// Etapas que tienen fotos (una etapa sin fotos, p. ej. "durante", simplemente no se muestra)
// Mosaico en bloques que siempre cuadran (4 columnas × 2 filas): L = 2×2, W = 2×1, S = 1×1, F = 4×2
const BLOQUES: Record<string, string[]> = { A: ['L', 'S', 'S', 'S', 'S'], B: ['L', 'S', 'S', 'W'], C: ['L', 'W', 'W'], D: ['L', 'L'], E: ['F'] };
const PLAN: Record<number, string[]> = { 1: ['E'], 2: ['D'], 3: ['C'], 4: ['B'], 5: ['A'], 6: ['C', 'C'], 7: ['A', 'D'], 8: ['B', 'B'], 9: ['A', 'B'], 10: ['A', 'A'] };
const tiposPara = (n: number) => {
  const bloques: string[] = [];
  while (n > 10) { bloques.push('A'); n -= 5; }
  return [...bloques, ...(PLAN[n] ?? [])].flatMap((b) => BLOQUES[b]);
};
const etapasConFotos = etapas
  .map((id) => ({ id, label: etapaLabel[id], fotos: fotosDe(p, id) }))
  .filter((e) => e.fotos.length > 0)
  .map((e) => ({ ...e, tipos: tiposPara(e.fotos.length) }));
const ordenadas = fotosOrdenadas(p);
const globalIndex = (f: Foto) => ordenadas.indexOf(f);
// Área y duración son opcionales: si no se cargaron, no se muestran (ni como «[DATO REAL]»).
const meta = [
  { k: 'Distrito', v: show(p.distrito) },
  ...(p.areaM2 ? [{ k: 'Área', v: `${p.areaM2} m²` }] : []),
  ...(p.dias ? [{ k: 'Duración', v: `${p.dias} ${p.dias === 1 ? 'día' : 'días'}` }] : []),
  ...(p.servicios.length ? [{ k: 'Servicios', v: p.servicios.join(' · ') }] : []),
];
// Compartir: abre WhatsApp con el enlace de esta ficha (no necesita el número de Luis).
const cotizar = `/cotizador?categoria=${p.categoria}&proyecto=${p.slug}`;
const share = `https://wa.me/?text=${encodeURIComponent(`${p.titulo} · SEIMA Servicios Generales ${Astro.url.href}`)}`;
---
<Base
  title={`${p.titulo} · SEIMA Servicios Generales`}
  description={`${p.titulo} (${cat}). ${p.servicios.join(', ')}. Proyecto de SEIMA en Lima y provincias.`}
  image={cover.src}
>
  <!-- PORTADA: comparador antes/después -->
  <section class="top dark">
    <div class="wrap">
      <div class="topbar">
        <BackButton />
        <nav class="crumbs" aria-label="Ruta"><a href="/proyectos">Proyectos</a> / <a href={`/proyectos?categoria=${p.categoria}`}>{catPrincipal}</a></nav>
      </div>
      <h1><Words text={p.titulo} /></h1>
      <ul class="meta" data-hero-in>
        {meta.map((m) => <li><span>{m.k}</span><strong>{m.v}</strong></li>)}
      </ul>
      <div class="actions" data-hero-in>
        <a class="btn btn--lg" href={cotizar}>Cotizar algo así →</a>
        <a class="btn btn--ghost btn--lg" href={share} target="_blank" rel="noopener" data-evento="compartir">Compartir por WhatsApp</a>
        <Presentation project={p} />
      </div>
      <div class="cover" transition:name={`foto-${p.slug}`}>
        <CompareSlider project={p} />
      </div>
      <p class="cover__hint"><span class="hint-drag">Arrastra para comparar el antes y el después</span><span class="hint-lado">Antes y después, uno al lado del otro</span></p>
    </div>
  </section>

  <!-- EL PROYECTO -->
  <section class="about light">
    <div class="wrap about__grid">
      <div>
        <p class="eyebrow">El proyecto</p>
        <p class="desc" data-reveal>{p.descripcion}</p>
      </div>
      <div class="about__side" data-reveal>
        <ul class="tags">{p.servicios.map((s) => <li class="tag">{s}</li>)}</ul>
        {!p.descripcion || p.descripcion.includes('DESCRIPCIÓN REAL') ? <p class="test">Proyecto de prueba: datos y fotos por reemplazar con los reales.</p> : null}
      </div>
    </div>
  </section>

  <!-- HISTORIA DE LA OBRA: una galería por etapa (sin foto principal aquí; las principales viven en el comparador) -->
  <section class="story light" data-story aria-labelledby="story-title">
    <div class="story__nav" data-story-nav>
      <div class="wrap story__navin">
        <p class="story__label" id="story-title">La historia de la obra</p>
        <nav class="story__chips" aria-label="Etapas de la obra">
          {etapasConFotos.map((e, i) => (
            <a class="story__chip" href={`#etapa-${e.id}`} data-story-chip data-stage={e.id} aria-current={i === 0 ? 'true' : undefined}>0{i + 1} · {e.label}</a>
          ))}
        </nav>
      </div>
      <div class="story__bar" aria-hidden="true"><i data-story-fill></i></div>
    </div>

    <div class="wrap">
      {etapasConFotos.map((e, i) => (
        <section class="stage" id={`etapa-${e.id}`} data-stage-block={e.id} aria-label={e.label}>
          <header class="stage__head">
            <span class="stage__n">0{i + 1}</span>
            <h3>{e.label}</h3>
            <span class="stage__count">{e.fotos.length} foto{e.fotos.length === 1 ? '' : 's'}</span>
          </header>
          <ul class="mosaic">
            {e.fotos.map((f, j) => (
              <li class="mosaic__item" data-t={e.tipos[j]}>
                <button type="button" class="shot" data-shot data-cursor="Ampliar" data-global={globalIndex(f)} aria-label={`${f.tipo === 'video' ? 'Ver video' : 'Ver foto'} ${j + 1} de ${e.fotos.length} — ${e.label}`}>
                  <Photo src={f.src} alt={f.alt} tone={(p.tono + i * 2 + j) % 6} fill label={`[FOTO REAL · ${e.label.toUpperCase()} ${j + 1}]`} />
                  {f.tipo === 'video' && <span class="shot__play">Video</span>}
                </button>
              </li>
            ))}
          </ul>
        </section>
      ))}
      {p.descripcion.includes('DESCRIPCIÓN REAL') ? <p class="story__text">[DESCRIPCIÓN REAL: qué pidió el cliente, qué se hizo y con qué materiales, en 3–4 líneas.]</p> : null}
    </div>
  </section>


  <section class="cta dark">
    <div class="wrap">
      <h2><Words text="¿Quieres algo" accent="así en tu casa?" /></h2>
      <div data-reveal><a class="btn btn--lg" href={cotizar}>Cotizar algo así →</a></div>
    </div>
  </section>
</Base>

<style>
  .top { padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem); }
  .topbar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; margin-bottom: 1.4rem; }
  .crumbs { font-size: 0.85rem; color: var(--muted-dark); }
  .crumbs a { text-decoration: none; }
  .crumbs a:hover { color: #fff; text-decoration: underline; }
  .top h1 { font-size: clamp(2.1rem, 6.5vw, 4.4rem); max-width: 18ch; }
  .meta { list-style: none; margin: 1.4rem 0 1.2rem; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem 2.2rem; }
  .meta li { display: grid; }
  .meta span { font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted-dark); }
  .meta strong { font-weight: 700; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem 1rem; margin-bottom: 1.8rem; }
  .cover { border-radius: 24px; }
  .cover__hint { margin-top: 0.8rem; font-size: 0.82rem; color: var(--muted-dark); }

  .about { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3rem); }
  .about__grid { display: grid; gap: 1.6rem; }
  @media (min-width: 800px) { .about__grid { grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; } }
  .desc { margin-top: 0.8rem; font-size: clamp(1.15rem, 2.6vw, 1.6rem); line-height: 1.45; max-width: 38ch; }
  .about__side { display: grid; gap: 1rem; }
  .tags { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .test { font-size: 0.85rem; color: var(--muted-light); }

  /* Historia de la obra: tres bloques seguidos, cada uno con su mosaico. Sin scroll atrapado. */
  .story { padding-bottom: clamp(3rem, 7vw, 5rem); }
  .story__nav { position: sticky; top: var(--header); z-index: 20; background: var(--paper); box-shadow: 0 10px 26px rgb(0 0 0 / 0.05); }
  .story__navin { display: grid; gap: 0.5rem; padding-block: 0.7rem 0; }
  .story__label { font-size: 0.72rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-text); }
  .story__chips { display: flex; gap: 0.5rem; overflow-x: auto; scrollbar-width: none; padding: 8px 8px 0.7rem; margin: -8px -8px 0; } /* el padding deja sitio al anillo de foco */
  .story__chips::-webkit-scrollbar { display: none; }
  .story__chip {
    flex: none; display: inline-flex; align-items: center; min-height: 44px; padding: 0.4rem 1rem; border-radius: 999px;
    font-weight: 700; font-size: 0.88rem; text-decoration: none; color: var(--ink); background: var(--tint);
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .story__chip:hover { background: var(--tint-2); }
  .story__chip[aria-current='true'] { background: var(--ink); color: #fff; }
  .story__bar { display: none; height: 3px; background: #ececec; overflow: hidden; }
  :global(html.motion) .story__bar { display: block; }
  .story__bar i { display: block; height: 100%; background: var(--red); transform-origin: 0 50%; transform: scaleX(0); }

  .stage { padding-top: clamp(2.2rem, 6vw, 4rem); scroll-margin-top: calc(var(--header) + 7rem); }
  .stage__head { display: flex; align-items: baseline; gap: 0.9rem; margin-bottom: 1.2rem; }
  .stage__n { color: var(--red-text); font-weight: 800; font-size: 0.95rem; }
  .stage h3 { font-size: clamp(1.8rem, 5vw, 3rem); }
  .stage__count { margin-left: auto; font-size: 0.85rem; color: var(--muted-light); }

  /* Mosaico: tamaños variados. Hasta ~10 fotos por etapa, así que se muestran todas. */
  .mosaic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); grid-auto-rows: 9.5rem; grid-auto-flow: dense; gap: 0.6rem; }
  .mosaic__item { position: relative; min-height: 0; }
  .mosaic__item[data-t='L'] { grid-column: span 2; grid-row: span 2; }
  .mosaic__item[data-t='W'] { grid-column: span 2; }
  .mosaic__item[data-t='F'] { grid-column: span 2; grid-row: span 2; }
  .shot { position: relative; display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: var(--r); overflow: hidden; }
  .shot :global(.photo) { border-radius: var(--r); }
  .shot__play { position: absolute; left: 0.6rem; bottom: 0.6rem; z-index: 2; background: rgb(14 14 14 / 0.82); color: #fff; border-radius: 999px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.28rem 0.6rem; }
  .shot:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
  .hint-lado { display: none; }
  .cover:has(.cmp--vertical) + .cover__hint .hint-drag { display: none; }
  .cover:has(.cmp--vertical) + .cover__hint .hint-lado { display: inline; }
  @media (max-width: 719px) {
    .cover:has(.cmp--vertical) + .cover__hint .hint-drag { display: inline; }
    .cover:has(.cmp--vertical) + .cover__hint .hint-lado { display: none; }
  }
  @media (min-width: 800px) {
    .mosaic { grid-template-columns: repeat(4, 1fr); grid-auto-rows: 11rem; gap: 0.8rem; }
    .mosaic__item[data-t='F'] { grid-column: span 4; }
  }
  :global(html.motion) .shot { opacity: 0; }
  .story__text { margin-top: clamp(2rem, 5vw, 3rem); max-width: 52ch; color: #3a3a3a; font-size: 1.05rem; }

  .cta { padding-block: clamp(3.5rem, 9vw, 6rem); }
  .cta .wrap { display: grid; gap: 1.5rem; justify-items: start; }
  .cta h2 { font-size: clamp(1.8rem, 5.5vw, 3.4rem); max-width: 14ch; }
</style>
