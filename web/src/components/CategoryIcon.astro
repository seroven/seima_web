---
// Íconos de línea (24×24) de cada ambiente. Dibujados para SEIMA; heredan el color del texto.
interface Props { slug: string; size?: number }
const { slug, size = 28 } = Astro.props;
---
<svg class="cicon" viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {slug === '' && (<>
    <rect x="3.5" y="3.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="3.5" width="7" height="7" rx="1.6" />
    <rect x="3.5" y="13.5" width="7" height="7" rx="1.6" /><rect x="13.5" y="13.5" width="7" height="7" rx="1.6" />
  </>)}
  {slug === 'cocinas' && (<>
    <path d="M6 3h12l2.5 5h-17z" /><path d="M4 12h16v8H4z" /><path d="M8 16h.01M12 16h.01M16 16h.01" stroke-width="3" />
  </>)}
  {slug === 'banos' && (<>
    <path d="M3 12h18v2a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" /><path d="M6 12V6a2 2 0 0 1 4 0" /><path d="M6 18l-1 3M18 18l1 3" />
  </>)}
  {slug === 'departamentos' && (<>
    <path d="M5 21V4h10v17" /><path d="M15 9h4v12" /><path d="M3 21h18" /><path d="M8 8h.01M12 8h.01M8 12h.01M12 12h.01M8 16h.01M12 16h.01" stroke-width="3" />
  </>)}
  {slug === 'melamina' && (<>
    <path d="M5 3h14v17H5z" /><path d="M12 3v17" /><path d="M9.5 11v2.5M14.5 11v2.5" /><path d="M7 20v2M17 20v2" />
  </>)}
  {slug === 'techos' && (<>
    <path d="M3 4h18" /><path d="M12 4v4" /><path d="M8 8h8l2 7H6z" /><path d="M10 18.5h4" />
  </>)}
  {slug === 'cocheras-fachadas' && (<>
    <path d="M3 10l9-6 9 6v11H3z" /><path d="M7 21v-7h10v7" /><path d="M7 17.5h10" />
  </>)}
  {slug === 'remodelaciones' && (<>
    <rect x="4" y="4" width="14" height="5" rx="1.4" /><path d="M18 6.5h2v5H12v3" /><rect x="10" y="14.5" width="4" height="6.5" rx="1" />
  </>)}
  {slug === 'locales' && (<>
    <path d="M3 9l1.5-5h15L21 9" /><path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0" /><path d="M4.5 12v8h15v-8" /><path d="M10 20v-5h4v5" />
  </>)}
</svg>

<style>
  .cicon { display: block; flex: none; transition: transform 0.35s cubic-bezier(0.2, 0.7, 0, 1); }
</style>
