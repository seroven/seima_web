---
// Corte frontal de una pared de cocina que se arma por oficios. Ilustración propia (no es foto de obra).
// Cada grupo [data-w] lo anima motion.ts: studs → boards → tile → power → cabinets → paint.
const studX = [24, 124, 224, 324, 424, 524, 618];
const boardX = [0, 160, 320, 480];
---
<svg class="wall" viewBox="0 0 640 440" role="img" aria-label="Pared de cocina armándose capa por capa: drywall, enchape, electricidad, melamina y pintura">
  <defs>
    <pattern id="wtile" width="60" height="40" patternUnits="userSpaceOnUse">
      <rect width="60" height="40" fill="#ece7de" />
      <path d="M0 0H60M0 20H60M30 0V20M0 20V40M60 20V40" fill="none" stroke="#bdb5a8" stroke-width="1.2" />
    </pattern>
    <filter id="wglow" x="-20%" y="-300%" width="140%" height="700%"><feGaussianBlur stdDeviation="6" /></filter>
  </defs>
  <rect width="640" height="440" rx="18" fill="#141414" />

  <!-- 01 Drywall: perfiles y placas -->
  <g data-w="studs">
    {studX.map((x) => <rect x={x} y="0" width="10" height="440" fill="#8c8c8c" />)}
    <rect x="0" y="0" width="640" height="10" fill="#6d6d6d" />
    <rect x="0" y="430" width="640" height="10" fill="#6d6d6d" />
  </g>
  <g data-w="boards">
    {boardX.map((x) => <rect x={x + 1} y="0" width="158" height="440" fill="#d9d4cc" stroke="#b9b2a6" />)}
    {boardX.map((x) => [40, 140, 240, 340, 410].map((y) => <circle cx={x + 14} cy={y} r="1.8" fill="#9b948a" />))}
  </g>

  <!-- 05 Pintura (queda detrás de los muebles) -->
  <g data-w="paint">
    <rect x="0" y="0" width="640" height="190" fill="#9e2433" />
    <rect x="0" y="0" width="640" height="190" fill="#000" opacity=".08" />
  </g>

  <!-- 02 Enchapado -->
  <g data-w="tile">
    <rect x="0" y="190" width="640" height="140" fill="url(#wtile)" />
    <rect x="0" y="186" width="640" height="5" fill="#bdb5a8" />
  </g>

  <!-- 03 Electricidad -->
  <g data-w="power">
    <path d="M123 262V212H380V176M513 262V218H470" fill="none" stroke="#e0283c" stroke-width="3" stroke-linejoin="round" />
    <rect x="110" y="262" width="26" height="36" rx="3" fill="#fff" stroke="#9b948a" />
    <circle cx="123" cy="274" r="3" fill="#333" /><circle cx="123" cy="286" r="3" fill="#333" />
    <rect x="500" y="262" width="26" height="36" rx="3" fill="#fff" stroke="#9b948a" />
    <circle cx="513" cy="274" r="3" fill="#333" /><circle cx="513" cy="286" r="3" fill="#333" />
  </g>
  <g data-w="led">
    <rect x="372" y="172" width="248" height="8" fill="#fff" filter="url(#wglow)" opacity=".85" />
    <rect x="372" y="170" width="248" height="5" fill="#fff" />
  </g>

  <!-- 04 Melamina -->
  <g data-w="cabinets">
    <rect x="380" y="24" width="240" height="142" rx="4" fill="#b79b7a" />
    <line x1="500" y1="24" x2="500" y2="166" stroke="#8a6f50" stroke-width="2" />
    <rect x="486" y="120" width="4" height="26" rx="2" fill="#0e0e0e" /><rect x="510" y="120" width="4" height="26" rx="2" fill="#0e0e0e" />
    <rect x="0" y="334" width="640" height="86" fill="#cbbfae" />
    {[160, 320, 480].map((x) => <line x1={x} y1="334" x2={x} y2="420" stroke="#a89a85" stroke-width="2" />)}
    {[80, 240, 400, 560].map((x) => <rect x={x - 14} y="344" width="28" height="4" rx="2" fill="#0e0e0e" />)}
    <rect x="0" y="322" width="640" height="14" fill="#0e0e0e" />
    <rect x="0" y="420" width="640" height="20" fill="#111" />
  </g>

  <!-- Rodillo que acompaña la pintura -->
  <g data-w="roller">
    <rect x="-8" y="70" width="64" height="26" rx="7" fill="#e0283c" />
    <path d="M56 83H78V118" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" />
  </g>
</svg>

<style>
  .wall { width: 100%; height: auto; border-radius: 18px; box-shadow: 0 30px 60px rgb(0 0 0 / 0.45); }
  .wall :global([data-w]) { transform-box: fill-box; }
</style>
