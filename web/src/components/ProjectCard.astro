---
import Photo from './Photo.astro';
import { categoryName, type Project } from '../data/projects';
interface Props { project: Project; ar?: string; class?: string }
const { project: p, ar = '4 / 3', class: cls } = Astro.props;
const cover = p.fotos.find((f) => f.etapa === 'despues') ?? p.fotos[0];
---
<a class:list={['pcard', cls]} href={`/proyectos/${p.slug}`} data-cat={p.categoria}>
  <div class="pcard__media" transition:name={`foto-${p.slug}`}>
    <Photo src={cover.src} alt={cover.alt} tone={p.tono} ar={ar} />
  </div>
  <div class="pcard__body">
    <span class="pcard__cat">{categoryName(p.categoria)}</span>
    <h3>{p.titulo}</h3>
  </div>
</a>
<style>
  .pcard { display: flex; flex-direction: column; gap: 0.9rem; text-decoration: none; height: 100%; }
  .pcard__media { border-radius: var(--r); }
  .pcard__cat { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red-text); }
  h3 { font-size: clamp(1.1rem, 2.4vw, 1.4rem); margin-top: 0.2rem; }
  :global(.dark) .pcard__cat { color: var(--red); }
  .pcard:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; }
</style>
