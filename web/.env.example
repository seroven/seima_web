# Número de WhatsApp de Luis, solo dígitos con código de país (ej. 51XXXXXXXXX).
# Nunca hardcodear en el código.
PUBLIC_WHATSAPP_NUMBER=

# URL base de la API, INCLUIDO el prefijo (ej. http://localhost:4000/api/v1 o https://seima-api.onrender.com/api/v1).
# Si falta, el cotizador igual abre WhatsApp pero no guarda la solicitud (POST /quotes).
PUBLIC_API_URL=
