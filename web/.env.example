# Número de WhatsApp de Luis, solo dígitos con código de país (ej. 51XXXXXXXXX).
# Nunca hardcodear en el código.
PUBLIC_WHATSAPP_NUMBER=

# URL base de la API, INCLUIDO el prefijo (ej. http://localhost:4000/api/v1 o https://seima-api.onrender.com/api/v1).
# Obligatoria para que el cotizador envíe las solicitudes (POST /quotes) y suba las fotos. Sin ella, "Enviar solicitud" muestra un aviso.
PUBLIC_API_URL=

# Mediciones de visitas: por defecto NO se miden las visitas desde localhost. Poner 1 solo para probarlas en local (necesita PUBLIC_API_URL).
PUBLIC_ANALYTICS_LOCAL=

# Direccion publica de la web al construirla (ej. https://seima-web.onrender.com). Con ella, Compartir por WhatsApp, el canonical
# y la imagen al compartir llevan la direccion real y no la de tu PC. En Render basta con SITE_URL; si falta, usa RENDER_EXTERNAL_URL.
SITE_URL=

# Facebook de SEIMA (enlace completo). Mientras falte, el pie de pagina lo muestra como pendiente.
PUBLIC_FACEBOOK_URL=
