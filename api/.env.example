# Variables COMUNES / referencia completa. Cada entorno tiene su archivo: .env.dev, .env.qa, .env.pd (y .env.test para pruebas).
# Aquí NO se define NODE_ENV: se deriva del entorno (dev=development, qa/pd=production).
# Si existe un .env, sus valores sirven de base y el archivo del entorno los sobrescribe.

# ===== Servidor =====
PORT=4000
# Prefijo de todas las rutas (versionado de la API)
API_PREFIX=/api/v1
# Orígenes permitidos por CORS, separados por coma (la web y, luego, el panel)
CORS_ORIGINS=http://localhost:4321
# En Render (detrás de un proxy) poner true para que el rate limit vea la IP real
TRUST_PROXY=false
LOG_LEVEL=info

# ===== Base de datos (PostgreSQL) =====
# Opción A: una sola URL (Render la entrega como DATABASE_URL). Si está, tiene prioridad.
# DATABASE_URL=postgresql://usuario:clave@host:5432/seima
# Opción B: datos sueltos
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=seima
# Schema de PostgreSQL donde se crean las tablas (se crea solo con migration:run si no existe). Por defecto: public
DB_SCHEMA=public
# true si el proveedor exige SSL (Render, etc.)
DB_SSL=false

# ===== Seguridad (JWT del panel administrativo) =====
# Mínimo 32 caracteres. Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Vida de la sesión de la app (refresh token). Ejemplos: 60d, 12h, 30m
JWT_REFRESH_EXPIRES_IN=60d
JWT_ISSUER=seima-api
JWT_AUDIENCE=seima-panel
BCRYPT_ROUNDS=12

# ===== Límites de peticiones =====
RATE_LIMIT_QUOTES_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_15MIN=10
# Firmas de subida de fotos por IP y hora (una por cotización con fotos)
RATE_LIMIT_UPLOADS_PER_HOUR=20

# ===== Cloudinary (fotos) =====
# Las TRES son necesarias para que el cotizador suba las fotos del cliente (el secret firma las subidas y nunca sale del servidor).
# Con solo el cloud name se arman las URLs públicas, pero las subidas responden 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta donde caen las fotos que suben los clientes desde el cotizador
CLOUDINARY_QUOTES_FOLDER=seima/quotes
# Carpeta de los proyectos de Luis. Cada uno queda en seima/projects/<id>
CLOUDINARY_PROJECTS_FOLDER=seima/projects

# ===== Firebase (avisos de cotizaciones nuevas). Las tres juntas; si faltan, la cotización se guarda igual =====
# Cuenta de servicio: Configuración del proyecto → Cuentas de servicio → clave privada.
# FIREBASE_PRIVATE_KEY va entre comillas, con los saltos de línea como \n
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== Reconstrucción de la web (solo en qa/pd) =====
# "Deploy hook" de la web en Render (Settings → Deploy Hook). Es una URL SECRETA: solo aquí o en el panel de Render, nunca en git.
# Con ella, al publicar/ocultar/editar una obra la API le pide a Render que reconstruya la web. En dev se deja vacía.
WEB_DEPLOY_HOOK_URL=

# ===== Usuario administrador inicial (solo para `npm run seed:admin`) =====
# El usuario es siempre `luis`. En dev y qa la contraseña es 123456.
# ADMIN_PASSWORD solo se usa en producción (pd) y debe tener al menos 10 caracteres.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Luis Rodríguez
