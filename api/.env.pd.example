# Entorno PD (producción). Copiar a .env.pd SOLO si necesitas correr migraciones desde tu PC:
#   npm run migration:run -- --env=pd --yes
# En Render NO subas el archivo: define estas variables en el panel y APP_ENV=pd.
PORT=4000
CORS_ORIGINS=https://URL-DE-LA-WEB
TRUST_PROXY=true
LOG_LEVEL=warn

DATABASE_URL=
DB_SSL=true

# DISTINTO al de dev y qa. Nunca lo compartas ni lo subas a git.
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Luis Rodríguez
