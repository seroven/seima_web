# Entorno PD (producción). Copiar a .env.pd SOLO si necesitas correr migraciones desde tu PC:
#   npm run migration:run -- --env=pd --yes
# En Render NO subas el archivo: define estas variables en el panel y APP_ENV=pd.
PORT=4000
CORS_ORIGINS=https://URL-DE-LA-WEB
TRUST_PROXY=true
LOG_LEVEL=warn

DATABASE_URL=
# Con DATABASE_URL el nombre de la base va dentro de la URL, pero el schema se sigue indicando aparte:
DB_SCHEMA=public
DB_SSL=true

# DISTINTO al de dev y qa. Nunca lo compartas ni lo subas a git.
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=60d
BCRYPT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (las tres de arriba son necesarias para subir las fotos del cotizador)
CLOUDINARY_PROJECTS_FOLDER=seima/projects

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== Reconstrucción de la web (solo en qa/pd) =====
# "Deploy hook" de la web en Render (Settings → Deploy Hook). Es una URL SECRETA: solo aquí o en el panel de Render, nunca en git.
# Con ella, al publicar/ocultar/editar una obra la API le pide a Render que reconstruya la web. En dev se deja vacía.
WEB_DEPLOY_HOOK_URL=

# En producción la contraseña de `luis` sale de aquí (mínimo 10 caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Luis Rodríguez
