# Base de datos SOLO para las pruebas (se vacía y se recrea con las migraciones en cada ejecución).
# Copiar a .env.test (se usa con npm test, que corre con --env=test).
PORT=4001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4321
LOG_LEVEL=silent

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=seima_test
DB_SCHEMA=public
DB_SSL=false

JWT_SECRET=clave-solo-para-pruebas-minimo-32-caracteres-xxxxxxxx
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=60d
BCRYPT_ROUNDS=10
RATE_LIMIT_QUOTES_PER_HOUR=1000
RATE_LIMIT_LOGIN_PER_15MIN=1000

CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=secreto-falso-de-pruebas
CLOUDINARY_PROJECTS_FOLDER=seima/projects

# El seed de pruebas crea `luis` / 123456. ADMIN_PASSWORD no se usa.
ADMIN_EMAIL=admin@seima.test
ADMIN_PASSWORD=ClaveDePrueba123!
ADMIN_NAME=Admin de pruebas
