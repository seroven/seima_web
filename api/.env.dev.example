# Entorno DEV (tu PC). Copiar a .env.dev  ·  usar:  npm run dev   (o  npm run <comando> -- --env=dev)
PORT=4000
CORS_ORIGINS=http://localhost:4321
LOG_LEVEL=debug
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=seima_dev
DB_SCHEMA=public
DB_SSL=false

# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=60d
BCRYPT_ROUNDS=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (las tres de arriba son necesarias para subir las fotos del cotizador)
CLOUDINARY_PROJECTS_FOLDER=seima/projects

# Avisos push. Si faltan, las cotizaciones se guardan igual.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# seed:admin crea el usuario `luis` con contraseña 123456. ADMIN_PASSWORD no se usa en dev.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador dev
