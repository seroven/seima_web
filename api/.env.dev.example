# Entorno DEV (tu PC). Copiar a .env.dev  ·  usar:  npm run dev   (o  npm run <comando> -- --env=dev)
PORT=4000
CORS_ORIGINS=http://localhost:4321
LOG_LEVEL=debug
TRUST_PROXY=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=seima_dev
DB_SSL=false

# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Para npm run seed:admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador dev
