# Entorno QA (pruebas con Luis / staging en Render). Copiar a .env.qa  ·  usar:  npm run <comando> -- --env=qa
# En Render NO subas el archivo: define estas mismas variables en el panel y APP_ENV=qa.
PORT=4000
CORS_ORIGINS=https://URL-DE-LA-WEB-QA
TRUST_PROXY=true
LOG_LEVEL=info

# Render entrega la URL de la base de QA
DATABASE_URL=
DB_SSL=true

# DISTINTO al de dev y pd
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador QA
